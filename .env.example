# ─────────────────────────────────────────────────────────────────────────────
# Recovik — environment variables. Copy to `.env` for local work, or to
# /etc/recovik/recovik.env on the server (chmod 600). Never commit real values.
# All variables are validated by astro:env (see astro.config.ts) and, on the
# server, by scripts/check-env.mjs before the service starts.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical URL used at BUILD time for canonical links, hreflang, sitemap.
# Leave empty to use `url` from src/config/site.config.ts.
SITE_URL=https://recovik.protosoftdev.com

# Email delivery for the forms: "smtp" in production, "test" only locally
# (test keeps messages in memory and delivers nothing).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS, required).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on form notifications, e.g. "Recovik Website <no-reply@recovik.com>"
MAIL_FROM=

# Cloudflare Turnstile — only needed when features.captcha is true in site.config.ts.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Form rate limit per IP address (per form).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# true ONLY behind a reverse proxy you control that overwrites X-Real-IP (nginx).
TRUST_PROXY=false

# Node server (production). nginx proxies form requests to this address.
HOST=127.0.0.1
PORT=4321
