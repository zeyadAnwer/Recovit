---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import FirstAid from '../../components/sections/FirstAid.astro';
import HomeSections from '../../components/sections/HomeSections.astro';
import Stats from '../../components/sections/Stats.astro';
import { localeParams, useI18n, type Locale } from '../../i18n';
import { getSectors, getServices } from '../../lib/content';

export const getStaticPaths = () => localeParams();

const { locale } = Astro.props as { locale: Locale };
const { t } = useI18n(locale);
const [services, sectors] = await Promise.all([getServices(locale), getSectors(locale)]);
---

<BaseLayout title={t.meta.home.title} exactTitle description={t.meta.home.description}>
  <Hero />
  <FirstAid />
  <Stats />
  <HomeSections services={services} sectors={sectors} />
</BaseLayout>
