---
/**
 * LegalPage — renders a legal content entry (privacy, terms) inside
 * PageLayout with its "last updated" date.
 *
 * @prop slug  "privacy" or "terms".
 */
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { routes, useI18n } from '../../i18n';
import { getLegalPage } from '../../lib/content';

interface Props {
  slug: 'privacy' | 'terms';
}

const { slug } = Astro.props;
const { locale, t, path } = useI18n(Astro.currentLocale);
const entry = await getLegalPage(locale, slug);
const { Content } = await render(entry);
const updated = new Intl.DateTimeFormat(locale === 'ar' ? 'ar-u-nu-latn' : 'en-GB', {
  dateStyle: 'long',
}).format(entry.data.updated);
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  label={`${t.common.lastUpdated}: ${updated}`}
  crumbs={[{ name: entry.data.title, href: path(routes[slug]) }]}
>
  <div class="container section">
    <div class="prose">
      <Content />
    </div>
  </div>
</PageLayout>
