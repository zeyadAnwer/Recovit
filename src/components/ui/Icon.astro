---
/**
 * Icon — renders one icon from the custom set in `icons.ts`.
 *
 * @prop name   Icon name (type-checked against the set).
 * @prop size   Rendered size in px. Default 24.
 * @prop label  Accessible name. Omit for decorative icons (aria-hidden).
 * @prop class  Extra classes.
 */
import { getIcon, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
const icon = getIcon(name);
---

<svg
  class:list={['icon', { 'icon--directional': icon.directional }, className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.body}
/>

<style>
  @layer components {
    .icon {
      flex-shrink: 0;
    }

    :global([dir='rtl']) .icon--directional {
      transform: scaleX(-1);
    }
  }
</style>
