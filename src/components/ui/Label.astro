---
/**
 * Label — small eyebrow text above headings, e.g. "Ransomware".
 *
 * @prop tone  "accent" (default), "muted" or "alert".
 * @prop as    Element to render. Default "p".
 */
interface Props {
  tone?: 'accent' | 'muted' | 'alert';
  as?: 'p' | 'span' | 'div';
  class?: string;
}

const { tone = 'accent', as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['label', `label--${tone}`, className]}>
  <slot />
</Tag>

<style>
  @layer components {
    .label {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      font-size: var(--step--1);
      font-weight: 650;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      line-height: 1.4;
    }

    .label::before {
      content: '';
      inline-size: 1.25rem;
      block-size: 2px;
      border-radius: 2px;
      background: currentcolor;
    }

    :global(:lang(ar)) .label {
      text-transform: none;
    }

    .label--accent {
      color: var(--color-accent);
    }

    .label--muted {
      color: var(--color-muted);
    }

    .label--alert {
      color: var(--color-alert);
    }
  }
</style>
